{
  "schemaVersion": 1,
  "description": "Vendor admission policy for Compound GPID external-skill imports.",
  "allowedRepositoryIdentities": [
    "https://github.com/Kilo-Org/kilocode",
    "https://github.com/worldbank/gpid"
  ],
  "allowedUpstreamSkillRoots": [
    ".github/skills/",
    "skills/"
  ],
  "maxBundleSizeBytes": 1048576,
  "maxFileCount": 64,
  "maxFileSizeBytes": 262144,
  "allowedFileExtensions": [
    ".md",
    ".json",
    ".yml",
    ".yaml",
    ".txt",
    ".csv"
  ],
  "blockedFileExtensions": [
    ".exe",
    ".bat",
    ".cmd",
    ".ps1",
    ".sh",
    ".bash",
    ".zsh",
    ".py",
    ".rb",
    ".pl",
    ".js",
    ".ts",
    ".mjs",
    ".cjs",
    ".dll",
    ".so",
    ".dylib",
    ".jar",
    ".war",
    ".ear",
    ".msi",
    ".app",
    ".dmg",
    ".deb",
    ".rpm",
    ".pkg",
    ".bin",
    ".run",
    ".elf",
    ".com",
    ".scr",
    ".vbs",
    ".vbe",
    ".wsf",
    ".wsh",
    ".psm1",
    ".psd1",
    ".psc1",
    ".psc2",
    ".msh",
    ".msh1",
    ".msh2",
    ".inf",
    ".reg",
    ".rgs",
    ".sct",
    ".hlp",
    ".chm",
    ".hta",
    ".cpl",
    ".msc",
    ".gadget",
    ".msp",
    ".mst",
    ".pif",
    ".lnk",
    ".url",
    ".website",
    ".webloc",
    ".desktop",
    ".application",
    ".xbap"
  ],
  "blockedSecretPatterns": [
    "(?i)api[_-]?key\\s*[:=]\\s*['\"][^'\"]{8,}",
    "(?i)secret[_-]?key\\s*[:=]\\s*['\"][^'\"]{8,}",
    "(?i)password\\s*[:=]\\s*['\"][^'\"]{4,}",
    "(?i)token\\s*[:=]\\s*['\"][^'\"]{8,}",
    "(?i)aws[_-]?access[_-]?key[_-]?id\\s*[:=]\\s*[A-Z0-9]{16,}",
    "(?i)aws[_-]?secret[_-]?access[_-]?key\\s*[:=]\\s*['\"][^'\"]{20,}",
    "(?i)private[_-]?key\\s*[:=]\\s*['\"]-----BEGIN",
    "(?i)OPENAI[_-]?API[_-]?KEY\\s*[:=]\\s*['\"]sk-",
    "(?i)GITHUB[_-]?TOKEN\\s*[:=]\\s*['\"]gh[ps]_",
    "ghp_[A-Za-z0-9]{36}",
    "gho_[A-Za-z0-9]{36}",
    "github_pat_[A-Za-z0-9_]{22,}"
  ],
  "blockedMarkdownInstructions": [
    "(?i)ignore\\s+(?:previous|all|prior)\\s+(?:\\w+\\s+)*instructions",
    "(?i)you\\s+are\\s+now\\s+",
    "(?i)disregard\\s+(all|previous|prior)\\s+",
    "(?i)override\\s+(system|instructions|rules)",
    "(?i)act\\s+as\\s+(?:if|though)\\s+you",
    "(?i)pretend\\s+(?:to\\s+be|you\\s+are)",
    "(?i)\\bDAN\\b.*jailbreak",
    "(?i)\\[SYSTEM\\]",
    "(?i)\\[INST\\]",
    "(?i)<\\|im_start\\|>",
    "(?i)<\\|im_end\\|>",
    "(?i)curl\\s+.*\\|\\s*(?:bash|sh|python|node)",
    "(?i)wget\\s+.*\\|\\s*(?:bash|sh|python|node)",
    "(?i)eval\\s*\\(",
    "(?i)exec\\s*\\(",
    "(?i)subprocess\\.call",
    "(?i)os\\.system\\s*\\("
  ],
  "approvedLicenses": [
    "MIT",
    "Apache-2.0",
    "BSD-2-Clause",
    "BSD-3-Clause",
    "ISC",
    "Unlicense",
    "CC0-1.0",
    "CC-BY-4.0",
    "CC-BY-SA-4.0",
    "0BSD"
  ],
  "quarantineDirectoryName": ".compound-gpid/quarantine",
  "reviewEvidenceDirectoryName": ".compound-gpid/vendor-reviews",
  "managedSkillRoot": ".github/skills/",
  "vendorApprovalRequired": true,
  "consumerReviewOnly": true,
  "canonicalSourceBranches": [
    "main",
    "feature/vendoring",
    "release/*"
  ],
  "canonicalSourceOrigin": "https://github.com/worldbank/gpid.git"
}
