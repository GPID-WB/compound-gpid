    {
      "id": "shell:cg-help",
      "name": "cg-help",
      "kind": "shell",
      "ownerModule": "cap-help",
      "supportedSuites": [
        "cg",
        "cr"
      ],
      "category": "help",
      "summary": "Query evidence-backed command help through confined single-use request and selection files.",
      "aliases": [],
      "intents": [
        "find command syntax and prerequisites",
        "query available commands and documented workflows"
      ],
      "usage": "cg-help (--prepare-request|--consume-request <uuid>|--render-selection <uuid>) [--root <path>] [--platform <copilot|claude-code|codex|opencode|kilo>] [--catalog <path> --source-root <path>]",
      "examples": [
        "cg-help --prepare-request --root . --platform kilo",
        "cg-help --consume-request <returned-uuid> --root . --platform kilo",
        "cg-help --render-selection <returned-uuid> --root . --platform kilo"
      ],
      "prerequisites": [
        "Python 3.8+, Git, and a writable canonical project root with no link or reparse ancestors.",
        "Current installed-clone catalog and definition evidence, plus valid strict project config and active manifest or recognized no-config legacy installation evidence.",
        "In Git projects, .compound-gpid/runtime/help-requests files must be untracked and ignored; cg-link manages the runtime ignore entry."
      ],
      "outputs": [
        "Schema-v1 JSON transport envelopes on stdout, with deterministic Markdown inside semantic results.",
        "Prepared request UUID and confined query path; candidate results prepare a selection path for allowed command IDs.",
        "Overview, exact command, candidates, documented workflow, unsupported, or error results; nonzero CLI errors also emit stderr diagnostics."
      ],
      "constraints": [
        "Choose exactly one operation. Write UTF-8 query text in place to the returned query file through a structured file-write tool; never pass query text as a shell argument.",
        "Use the returned UUID and the same project root, platform, catalog, and source-root binding for consume and render operations.",
        "Query input is limited to 4096 bytes; selection input is a JSON array of at most three distinct allowed command IDs, limited to 1024 bytes. Requests and selections are single-use and expire after 300 seconds.",
        "Only candidates permit selection rendering. Write the selection array in place to the returned selection file; changed catalog or project evidence requires a new request.",
        "--catalog and --source-root are paired local fixture overrides, not normal catalog selection flags.",
        "CLI exit categories are 0 success, 2 invalid transport or input, 3 invalid evidence, and 4 filesystem or I/O failure; missing Python makes the wrapper exit 1."
      ],
      "relatedCommands": [
        {
          "id": "shell:cg-link",
          "relation": "related"
        }
      ],
      "sourcePath": "bin/cg-help",
      "definitionSources": [
        "bin/cg-help",
        "bin/cg-help.cmd",
        "install.ps1",
        "scripts/cg_help.py",
        "scripts/cg_project_manifest.py",
        "scripts/help/catalog.py",
        "scripts/help/query.py",
        "scripts/install.sh",
        "scripts/link.ps1",
        "scripts/link.sh",
        "scripts/schemas/help_catalog_schema.json",
        "scripts/schemas/help_transport_schema.json",
        "scripts/secure_fs.py"
      ],
      "definitionDigest": "5679917c11a0bb85b08634cdc130fe25c5eb5e7cac06df87d4815852f267d0da",
