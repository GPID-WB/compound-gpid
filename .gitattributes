# Ensure bash scripts always use LF line endings in the repo
# (prevents CRLF corruption when checked out on Windows)
*.md            text eol=lf
*.json          text eol=lf
*.toml          text eol=lf
*.py            text eol=lf
*.ps1           text eol=lf
*.sh            text eol=lf
bin/cg-*        text eol=lf
**/cg-skill-management/templates/*.svg text eol=lf
**/cg-skill-management/templates/*.txt text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.html          text eol=lf

# Ensure Windows batch wrappers keep CRLF (required by CMD.EXE)
bin/*.cmd       text eol=crlf

