{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run all Pester tests (safe)",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/tests/Run-Tests.ps1"
            ],
            "windows": {
                "command": "powershell",
                "args": [
                    "-ExecutionPolicy", "Bypass",
                    "-File", "${workspaceFolder}\\tests\\Run-Tests.ps1"
                ]
            },
            "osx": {
                "command": "pwsh"
            },
            "linux": {
                "command": "pwsh"
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "focus": true
            },
            "problemMatcher": []
        },
        {
            "label": "Run Pester tests (FailFast)",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/tests/Run-Tests.ps1",
                "-FailFast"
            ],
            "windows": {
                "command": "powershell",
                "args": [
                    "-ExecutionPolicy", "Bypass",
                    "-File", "${workspaceFolder}\\tests\\Run-Tests.ps1",
                    "-FailFast"
                ]
            },
            "osx": {
                "command": "pwsh"
            },
            "linux": {
                "command": "pwsh"
            },
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "focus": true
            },
            "problemMatcher": []
        }
    ]
}
