# NOTE: compound-gpid.context.md is intentionally not listed here — it is shared institutional knowledge and must be committed.
# NOTE: compound-gpid.local.md is intentionally NOT listed here either — it is team-shared config
# (language, project-type, review-depth, shared ## Notes safety rules) and must be committed so every
# worktree, clone, and team member receives it without manual copying. Do NOT re-add it to .gitignore.

# .cg-docs/ and all subdirectories are institutional knowledge — do NOT add to .gitignore
# (brainstorms, plans, reviews, solutions, competitive-reviews/ — all must be version-controlled)
# Legacy cg-index outputs are generated compatibility artifacts. The canonical
# committed brain artifacts are .cg-docs/BRAIN*.md and .cg-docs/brain-index.json.
.cg-docs/DIGEST.md
.cg-docs/search-index.json

# wiki/ is intentionally NOT listed here — it is committed project documentation
# generated by @cg-wiki. Do not add wiki/ to .gitignore.

# User's version preference (per-machine, never committed)
.cg-version

# OS
.DS_Store
Thumbs.db

# IDE
# .vscode/ — only tasks.json and settings.json are committed (safe Pester runner + settings)
.vscode/*
!.vscode/tasks.json
!.vscode/settings.json
.posit/
.idea/
.tmp/

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/

# Testing & profiling
.pytest_cache/
.coverage
htmlcov/
*.prof

# Pester test runner artifacts (session-local, not committed)
tests/last-run.json
tests/.last-run.tmp
# Pester debug capture files (tail parser, triage block outputs) — session-local artifacts,
# not committed. Test fixture files (tail.txt etc.) are negated below and tracked separately.
tests/*.txt
!tests/tail.txt
!tests/tail2.txt
!tests/tail3.txt
!tests/triage-blocks.txt

# R
.Rhistory
.RData
.Rproj.user/
.Renviron

# Stata
*.smcl
*.gph
# Stata and other generated log files
*.log

# Secrets — never commit
.env
*.env.local

# Release and PR automation (ephemeral — GitHub is the source of truth)
RELEASE_NOTES.md
release-result.txt
pr-result.txt
.docs-build-metadata.json

# Generated artifact indexes are runtime-only; generated command/skill/agent trees stay tracked.
.agents/model-mapping.codex.json

# Generator recovery files (secure-write backup, not committed)
*.previous

# Local skill prototyping area should not be committed.
.agents/skills/skill-creator/

# Runtime managed-copy marker written into each copy-directory unit by
# scripts/link.ps1 (and its transient .tmp-* / .bak-* siblings). These are
# per-machine state, not generated-tree content, and must never be committed.
**/.compound-gpid-managed-copy.json*

# Project-local projection state (R5/R6): the committed active manifest is the
# reviewable selection artifact; mutable ownership state, the publication
# journal, and staging/quarantine/transient recovery files are per-project
# runtime state and must never be committed.
.compound-gpid/projection-ownership.json
.compound-gpid/projection-transaction.json
.compound-gpid/staging/
.compound-gpid/quarantine/
.compound-gpid/vendor-reviews/
.compound-gpid/*.tmp
.compound-gpid/*.bak

