# Compound GPID local config (user-specific, never committed)
compound-gpid.local.md
# NOTE: compound-gpid.context.md is intentionally not listed here — it is shared institutional knowledge and must be committed.

# .cg-docs/ and all subdirectories are institutional knowledge — do NOT add to .gitignore
# (brainstorms, plans, reviews, solutions, competitive-reviews/ — all must be version-controlled)

# User's version preference (per-machine, never committed)
.cg-version

# OS
.DS_Store
Thumbs.db

# IDE
# .vscode/ is intentionally tracked — tasks.json provides the shared safe Pester runner
.idea/
.tmp/

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/

# Testing & profiling
.pytest_cache/
.coverage
htmlcov/
*.prof

# Pester test runner artifacts (session-local, not committed)
tests/last-run.json
tests/.last-run.tmp
# Pester debug capture files (tail parser, triage block outputs) — session-local, not committed
tests/*.txt

# R
.Rhistory
.RData
.Rproj.user/
.Renviron

# Stata
*.smcl
*.gph
*.log

# Secrets — never commit
.env
*.env.local

# Release automation (ephemeral — GitHub Release is the source of truth)
RELEASE_NOTES.md
release-result.txt
