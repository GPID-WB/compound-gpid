        "scripts/install.sh",
        "scripts/link.ps1",
        "scripts/link.sh",
        "scripts/schemas/help_catalog_schema.json",
        "scripts/schemas/help_transport_schema.json",
        "scripts/secure_fs.py"
      ],
      "definitionDigest": "da38008e95a67255681da55172acd4f07971ead760dcc3e9058e65c11486589d",
      "documentationTargets": [],
