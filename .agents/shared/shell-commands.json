      "id": "shell:cg-autopilot-control",
      "name": "cg-autopilot-control",
      "kind": "shell",
      "ownerModule": "suite-cg",
      "supportedSuites": ["cg"],
      "category": "delivery",
      "summary": "Inspect Kilo autopilot eligibility and prior control state without writing.",
      "aliases": [],
      "intents": ["inspect autopilot plan eligibility", "inspect prior autopilot control state"],
      "usage": "cg-autopilot-control inspect --root <repo> --plan <path> --batches <segments> --base <branch> [--ci-timeout 30m]",
      "examples": ["cg-autopilot-control inspect --root . --plan .cg-docs/plans/example.md --batches 1 --base origin/dev"],
      "prerequisites": ["Python 3.8+, Git, and the installed Compound GPID helper with its Kilo command and contract."],
      "outputs": ["Exit 0 with one JSON report on stdout for either eligible or blocked inspection; read status and blockers to determine eligibility. Argument, plan or operation errors exit 1 with diagnostics on stderr and no report."],
      "constraints": ["Only inspect is enabled; other helper operations return operation-not-implemented.", "An explicit --root is required; the helper never selects the consumer root from its installation directory.", "--resume is mutually exclusive with --plan, --batches and --base.", "Inspection does not enable production autopilot execution."],
      "relatedCommands": [{"id": "slash:cg-autopilot", "relation": "related"}],
      "sourcePath": "bin/cg-autopilot-control",
      "definitionSources": ["bin/cg-autopilot-control", "bin/cg-autopilot-control.cmd", "install.ps1", "scripts/cg_autopilot.py", "scripts/install.sh"],
      "definitionDigest": "fe49cd33277caaa496d59c8fb68a52109df1ad1a1c3aedca45e88f11eae11d6b",
      "documentationTargets": [],
      "supportedPlatforms": ["kilo"],
      "supportedOS": ["posix", "windows"],
      "availability": {"status": "conditional", "evidence": [{"os": "posix", "sourcePath": "bin/cg-autopilot-control"}, {"os": "windows", "sourcePath": "bin/cg-autopilot-control.cmd"}]},
