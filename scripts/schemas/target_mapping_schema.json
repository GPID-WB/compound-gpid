{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Compound GPID Target Mapping",
  "description": "Schema for .github/shared/target-mapping.json — maps canonical .github/ assets to native platform trees.",
  "type": "object",
  "required": ["schemaVersion", "description", "targets"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "description": { "type": "string" },
    "targets": {
      "type": "array",
      "items": { "$ref": "#/definitions/target" },
      "minItems": 1
    }
  },
  "definitions": {
    "target": {
      "type": "object",
      "required": ["id", "name", "generatedTreePath", "modelMappingMode", "capabilities", "formats", "outputPaths"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "name": { "type": "string" },
        "generatedTreePath": { "type": ["string", "null"], "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000\\\\]+$" },
        "modelMappingMode": { "type": "string", "enum": ["role-only", "tier", "exact"] },
        "capabilities": {
          "type": "object",
          "required": ["supportsNativeCommands", "supportsNativeSkills", "supportsNativeSubagents", "supportsMultiVendorModels", "requiresRootAdapter"],
          "properties": {
            "supportsNativeCommands": { "type": "boolean" },
            "supportsNativeSkills": { "type": "boolean" },
            "supportsNativeSubagents": { "type": "boolean" },
            "supportsMultiVendorModels": { "type": "boolean" },
            "requiresRootAdapter": { "type": "boolean" }
          }
        },
        "formats": {
          "type": "object",
          "required": ["commandFormat", "skillFormat", "agentFormat"],
          "properties": {
            "commandFormat": { "type": "string" },
            "skillFormat": { "type": "string" },
            "agentFormat": { "type": "string" },
            "fallbackAgentFormat": { "type": "string" }
          }
        },
        "outputPaths": {
          "type": "object",
          "required": ["commands", "skills", "agents"],
          "properties": {
            "commands": { "$ref": "#/definitions/repoPath" },
            "skills": { "$ref": "#/definitions/repoPath" },
            "agents": { "$ref": "#/definitions/repoPath" },
            "instructions": { "$ref": "#/definitions/repoPath" },
            "shared": { "$ref": "#/definitions/repoPath" },
            "rootAdapter": { "$ref": "#/definitions/repoPath" },
            "modelMapping": { "$ref": "#/definitions/repoPath" },
            "config": { "$ref": "#/definitions/repoPath" }
          }
        },
        "modelMapping": {
          "type": "object",
          "properties": {
            "coding": { "type": ["string", "null"] },
            "review": { "type": ["string", "null"] },
            "reasoning": { "type": ["string", "null"] },
            "mechanical": { "type": ["string", "null"] },
            "inherited": { "type": ["string", "null"] },
            "fallback": { "type": ["string", "null"] },
            "cross-vendor-review": { "type": ["string", "null"] }
          }
        },
        "installUnits": {
          "type": "array",
          "items": { "$ref": "#/definitions/installUnit" }
        }
      }
    },
    "installUnit": {
      "type": "object",
      "required": ["type", "source", "target", "strategy"],
      "properties": {
        "type": { "type": "string", "enum": ["directory", "file"] },
        "source": { "$ref": "#/definitions/repoPath" },
        "target": { "$ref": "#/definitions/repoPath" },
        "strategy": { "type": "string", "enum": ["link-directory", "managed-copy", "generated-copy", "config-copy-or-snippet"] },
        "manualSnippet": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "strategy": { "const": "link-directory" } } },
          "then": { "properties": { "type": { "const": "directory" } } },
          "else": { "properties": { "type": { "const": "file" } } }
        }
      ]
    },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000\\\\]+$",
      "description": "Basic structural guard only. The canonical Python validator (_validate_repo_relative_path) enforces full constraints: no empty components, no '.' parts, no trailing dots/spaces, no Windows reserved names. If this regex needs strengthening, match it against the Python validator — do not weaken the Python validator."
    }
  }
}
